<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:tint="@color/onBackground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Đặt lại mật khẩu"
            android:textColor="@color/onBackground"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nhập email, mã xác thực và mật khẩu mới của bạn."
            android:textColor="#9AA7B2"
            android:textSize="14sp" />

        <TextView
            android:layout_marginTop="24dp"
            android:text="Email"
            android:textColor="@color/onBackground"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/edtResetEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/edt_email"
            android:padding="16dp"
            android:inputType="textEmailAddress"
            android:textColor="@color/white"

            android:textColorHint="#7F8C99" />

        <TextView
            android:layout_marginTop="16dp"
            android:text="Mã xác thực"
            android:textColor="@color/onBackground"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/edtResetToken"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/edt_email"
            android:padding="16dp"
            android:inputType="text"
            android:textColor="@color/white"
            android:textColorHint="#7F8C99" />

        <TextView
            android:layout_marginTop="16dp"
            android:text="Mật khẩu mới"
            android:textColor="@color/onBackground"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/edtNewPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/edt_email"
            android:padding="16dp"
            android:inputType="textPassword"
            android:textColor="@color/white"

            android:textColorHint="#7F8C99" />

        <TextView
            android:layout_marginTop="16dp"
            android:text="Nhập lại mật khẩu"
            android:textColor="@color/onBackground"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/edtConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/edt_email"
            android:padding="16dp"
            android:inputType="textPassword"
            android:textColor="@color/white"

            android:textColorHint="#7F8C99" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnResetPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="Đặt lại mật khẩu"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:background="@drawable/btn_login" />

        <TextView
            android:id="@+id/tvResetMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Nếu bạn đã nhận mã, nhập mã và mật khẩu mới để hoàn tất."
            android:textColor="#9AA7B2"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
