<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="0dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="0dp">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_input"
        android:padding="6dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical">
        <RadioGroup
            android:id="@+id/rgDiscountType"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:background="@android:color/transparent"
            android:layout_gravity="center_vertical">
            <RadioButton
                android:id="@+id/rbPercent"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Phần trăm (%)"
                android:checked="true"
                android:textColor="#2563EB"
                android:textSize="14sp"
                android:background="@android:color/transparent"
                android:buttonTint="#2563EB"
                android:gravity="center"
                android:paddingHorizontal="16dp" />
            <RadioButton
                android:id="@+id/rbFixed"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Số tiền cố định (đ)"
                android:textColor="#2563EB"
                android:textSize="14sp"
                android:background="@android:color/transparent"
                android:buttonTint="#2563EB"
                android:gravity="center"
                android:paddingHorizontal="16dp" />
        </RadioGroup>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_input"
        android:padding="8dp"
        android:gravity="center_vertical">
        <EditText
            android:id="@+id/edtDiscountValue"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="Mức giảm"
            android:inputType="numberDecimal"
            android:textColorHint="#64748B"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:background="@drawable/edittext_bg"
            android:padding="12dp"
            android:gravity="center_vertical|start"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/edtDiscountMax"
            android:layout_width="120dp"
            android:layout_height="44dp"
            android:hint="Không giới hạn"
            android:inputType="numberDecimal"
            android:textColorHint="#64748B"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:background="@drawable/edittext_bg"
            android:padding="12dp"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical|start"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
