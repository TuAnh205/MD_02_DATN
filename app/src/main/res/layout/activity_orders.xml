<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBackOrders"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_back"
            android:tint="#122046"
            android:contentDescription="Quay lại" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Đơn hàng"
            android:textColor="#122046"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Tab Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tabPending"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Chờ xác nhận"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#0A6ED8"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabConfirmed"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Xác nhận"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#64748B"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tabShipping"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Đang giao"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#64748B"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tabDelivered"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Đã giao"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#64748B"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tabCancelled"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Hủy đơn"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#64748B"
                    android:textSize="15sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Tab indicator bar -->
        <View
            android:id="@+id/tabIndicator"
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_marginStart="24dp"
            android:background="#0A6ED8" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E6EDF8" />

    <!-- Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/progressLoadingOrders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="12dp"
            android:paddingBottom="80dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tvNoOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Không có đơn hàng"
            android:gravity="center"
            android:textColor="#64748B"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- FAB thêm đơn -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddOrder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@drawable/ic_plus"
        android:contentDescription="Thêm đơn hàng" />

</LinearLayout>