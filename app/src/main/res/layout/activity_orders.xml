<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="15dp"
    android:background="#F5F7FA">
    <LinearLayout
        android:id="@+id/mainContentArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#FFFFFF"
            android:elevation="2dp">
            <ImageView
                android:id="@+id/ivToggleSidebar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="12dp"
                android:src="@drawable/ic_menu"
                android:background="@drawable/bg_circle_gray"
                android:contentDescription="Mở/đóng menu" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Đơn hàng"
                android:textColor="#122046"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF">
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">
                    <TextView
                        android:id="@+id/tabPending"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Chờ xác nhận"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#0A6ED8"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tabConfirmed"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Xác nhận"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#64748B"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tabShipping"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Đang giao"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#64748B"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tabDelivered"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Đã giao"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#64748B"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tabCancelled"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Hủy đơn"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#64748B"
                        android:textSize="15sp" />
                </LinearLayout>
            </HorizontalScrollView>
            <View
                android:id="@+id/tabIndicator"
                android:layout_width="60dp"
                android:layout_height="3dp"
                android:layout_marginStart="24dp"
                android:background="#0A6ED8" />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E6EDF8" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ProgressBar
                android:id="@+id/progressLoadingOrders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerOrders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="12dp"
                android:paddingBottom="80dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clipToPadding="false" />
            <TextView
                android:id="@+id/tvNoOrders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Không có đơn hàng"
                android:gravity="center"
                android:textColor="#64748B"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddOrder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            android:src="@drawable/ic_plus"
            android:contentDescription="Thêm đơn hàng" />
    </LinearLayout>
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/sidebarContainer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="24dp"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Core-Tech"
                android:textColor="#0A6ED8"
                android:textSize="22sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/ivCloseSidebar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                android:tint="#0A6ED8"
                android:contentDescription="Đóng" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kênh quản lý shop"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E6EDF8"
            android:layout_marginBottom="12dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/menuDashboard"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_sidebar_item"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_home"
                    android:tint="#0A6ED8" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bảng điều khiển"
                    android:textColor="#122046"
                    android:textSize="15sp"
                    android:layout_marginStart="14dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/menuCategories"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_sidebar_item"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_category"
                    android:tint="#0A6ED8" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sản phẩm"
                    android:textColor="#122046"
                    android:textSize="15sp"
                    android:layout_marginStart="14dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/menuOrders"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_sidebar_item_active"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_cart"
                    android:tint="#0A6ED8" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đơn hàng"
                    android:textColor="#0A6ED8"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginStart="14dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/menuCustomers"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_sidebar_item"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_user"
                    android:tint="#0A6ED8" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Khách hàng"
                    android:textColor="#122046"
                    android:textSize="15sp"
                    android:layout_marginStart="14dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/menuVoucher"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_sidebar_item"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_voucher"
                    android:tint="#0A6ED8" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Voucher"
                    android:textColor="#122046"
                    android:textSize="15sp"
                    android:layout_marginStart="14dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/menuReviews"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_sidebar_item"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_star"
                    android:tint="#0A6ED8" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đánh giá"
                    android:textColor="#122046"
                    android:textSize="15sp"
                    android:layout_marginStart="14dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/menuRevenue"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_sidebar_item"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_payment"
                    android:tint="#0A6ED8" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Doanh thu"
                    android:textColor="#122046"
                    android:textSize="15sp"
                    android:layout_marginStart="14dp" />
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E6EDF8"
            android:layout_marginBottom="16dp" />
        <LinearLayout
            android:id="@+id/layoutShopUserCard"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_user"
                android:tint="#0A6ED8" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tài khoản shop"
                    android:textColor="#122046"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xem hồ sơ"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>