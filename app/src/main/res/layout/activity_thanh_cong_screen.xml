<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F5F7">

    <!-- Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="top|center_horizontal">

        <!-- Pháo hoa -->
        <ImageView
            android:id="@+id/imgConfetti"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="-30dp"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:src="@drawable/phaohoa" />

        <!-- Icon success -->
        <ImageView
            android:id="@+id/imgSuccess"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="-55dp"
            android:src="@drawable/ic_success_round" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Đặt Hàng Thành Công"
            android:textColor="#111827"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Cảm ơn bạn đã tin tưởng và mua sắm tại cửa hàng của chúng tôi.\nĐơn hàng của bạn đang được xử lý, vui lòng chú ý điện thoại để nhận thông tin mới nhất."
            android:textColor="#444444"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBackHome"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_btn_blue"
        android:text="Quay lại trang chủ"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

</LinearLayout>