<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_marginBottom="12dp"
    android:padding="16dp"
    android:elevation="1dp">

    <!-- Row 1: Mã đơn + Badge trạng thái -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvOrderHistoryId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="#DH-20240524"
            android:textColor="#0A6ED8"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOrderHistoryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang giao"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_badge_active" />
    </LinearLayout>

    <!-- Row 2: Ngày tạo -->
    <TextView
        android:id="@+id/tvOrderHistoryDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="24/05/2026 • 14:30"
        android:textColor="#64748B"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <!-- Row 3: Ảnh + Tên khách + Sản phẩm + Giá -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/imgOrderHistoryProduct"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_image_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/tvOrderHistoryCustomerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nguyễn Văn A"
                android:textColor="#122046"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOrderHistorySummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3 sản phẩm • MacBook Air M2, AirPods Pro + 1 sản phẩm khác"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvOrderHistoryTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25.500.000đ"
                android:textColor="#0A6ED8"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
