<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_card"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvReviewer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#2F80FF"
            android:textStyle="bold"
            android:text="Tên người dùng"/>

        <RatingBar
            android:id="@+id/ratingBarReview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1.0"
            android:isIndicator="true"
            android:rating="5"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvReviewContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#000000"
        android:text="Nội dung đánh giá"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tvReviewDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#000000"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:text="01/04/2026"/>

    <LinearLayout
        android:id="@+id/layoutReplyContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="10dp"
        android:layout_marginTop="8dp"
        android:background="#F5F7FA">

        <TextView
            android:id="@+id/tvReplyLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phản hồi từ shop"
            android:textColor="#2F80FF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvReplyContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:text="Nội dung phản hồi" />

        <TextView
            android:id="@+id/tvReplyInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#828282"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:text="Trả lời bởi admin • 01/04/2026" />
    </LinearLayout>

</LinearLayout>


