<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tvVoucherName"
            android:text="Voucher name"
            android:textColor="@color/onBackground"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/tvVoucherStatus"
            android:text="Còn hạn"
            android:textColor="@color/green"
            android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="0dp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvVoucherDesc"
        android:text="Mô tả"
        android:textColor="@color/onSurface"
        android:textSize="13sp"
        android:layout_marginTop="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">
        <TextView
            android:id="@+id/tvVoucherCode"
            android:text="CODE123"
            android:textColor="#2F80FF"
            android:textSize="12sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvVoucherDiscount"
            android:text="-10%"
            android:textColor="#E53935"
            android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvVoucherDate"
            android:text="24/05/2026 - 31/05/2026"
            android:textColor="#757575"
            android:textSize="12sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvVoucherUsage"
        android:text="Đã dùng 0/10"
        android:textColor="#0F172A"
        android:textSize="12sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">
        <ImageView
            android:id="@+id/btnEditVoucher"
            android:src="@drawable/ic_edit"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sửa voucher" />
        <ImageView
            android:id="@+id/btnDeleteVoucher"
            android:src="@drawable/ic_delete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Xóa voucher"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
